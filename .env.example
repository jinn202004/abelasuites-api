PORT=5000
# Local: install MongoDB and run `mongod`, then:
MONGODB_URI=mongodb://127.0.0.1:27017/joanah
# Atlas: use your SRV string; ensure cluster is running + your IP is allowed in Network Access.
# Test connection without starting the API: npm run db:ping
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# New reviews: isApproved follows AUTO_APPROVE_REVIEWS (default true when unset).
# AUTO_APPROVE_REVIEWS=false
#
# Public /api/testimonials: by default lists ALL saved reviews. Set true to hide non-approved ones:
# TESTIMONIALS_REQUIRE_APPROVAL=true
#
# Bulk-approve old pending rows: npm run approve-reviews

# Optional: scripts/create-housekeeping.js (overrides built-in dev defaults)
# HOUSEKEEPING_EMAIL=housekeeping@abela.local
# HOUSEKEEPING_PASSWORD=Housekeep1!
